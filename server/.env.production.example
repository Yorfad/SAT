# Backend Environment Variables for Railway
# Copy these to Railway's environment variables section

# ==========================================
# DATABASE (Auto-generated by Railway MySQL)
# ==========================================
# Railway will auto-fill these when you add MySQL service
# You can reference them like: ${{MySQL.MYSQL_HOST}}
MYSQL_HOST=${{MySQL.MYSQL_HOST}}
MYSQL_PORT=${{MySQL.MYSQL_PORT}}
MYSQL_USER=${{MySQL.MYSQL_USER}}
MYSQL_PASSWORD=${{MySQL.MYSQL_PASSWORD}}
MYSQL_DATABASE=${{MySQL.MYSQL_DATABASE}}

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=production
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAT_ENC_KEY=REPLACE_WITH_GENERATED_KEY

# ==========================================
# CLOUDINARY (File Storage)
# ==========================================
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# CORS
# ==========================================
# Add your Vercel frontend URL after deploying
ALLOWED_ORIGINS=https://sat-frontend.vercel.app,https://your-custom-domain.com

# ==========================================
# EMAIL (Optional - for notifications)
# ==========================================
# If using Gmail, you need an "App Password"
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ==========================================
# SCHEDULER
# ==========================================
# Set to 'true' to run cron jobs on startup (testing only)
RUN_SCHEDULER_ON_START=false
