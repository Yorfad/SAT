# ============================================
# Variables de Entorno para SAT (Docker)
# ============================================
# Copia este archivo como .env y ajusta los valores
# ============================================

# ============================================
# Base de Datos
# ============================================
DB_ROOT_PASSWORD=admin123
DB_USER=satuser
DB_PASSWORD=satpass123
DB_DATABASE=sat_acme
DB_PORT=3310

# ============================================
# Tenants (Multi-empresa)
# ============================================
# Formato JSON: {"slug":{"database":"nombre_bd"}}
TENANTS={"acme":{"database":"sat_acme"},"solis":{"database":"sat_solis"}}

# ============================================
# JWT (Autenticación)
# ============================================
# IMPORTANTE: Cambia este secreto en producción
# Genera uno con: openssl rand -hex 64
JWT_SECRET=0e9b97b6d4755d0f2a3d066da1532db453a0b7ac6a369c8c063cfafa6b0b55f5661ebb6100bf45f8444c8bdcebba750381eab496aa55fd46f5b2978370cebed2
JWT_EXPIRES_IN=7d

# ============================================
# CORS (Orígenes permitidos)
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:3000

# ============================================
# Encriptación (Contraseñas SAT)
# ============================================
# IMPORTANTE: Cambia esta clave en producción
# Debe ser de 64 caracteres hexadecimales (32 bytes)
SAT_ENC_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# ============================================
# Puertos
# ============================================
BACKEND_PORT=3000
FRONTEND_PORT=80

# ============================================
# Frontend
# ============================================
VITE_API_URL=http://localhost:3000/api

# ============================================
# Ambiente
# ============================================
NODE_ENV=development
